# Cloudflare resources
CF_WORKER_NAME=homophone-meme-api
CF_WEB_PROJECT=homophone-meme
CF_ADMIN_PROJECT=homophone-meme-admin
D1_DATABASE_NAME=homophone-meme-db
D1_DATABASE_ID=
R2_BUCKET=homophone-meme-assets

# Public endpoints
PUBLIC_WEB_URL=https://<public-project>.pages.dev
ADMIN_PUBLIC_URL=https://<admin-project>.pages.dev
API_ORIGIN=https://<api-worker>.<workers-subdomain>.workers.dev
WEB_ORIGINS=https://<public-project>.pages.dev
ADMIN_ORIGINS=https://<admin-project>.pages.dev

# Browser build
NEXT_PUBLIC_AUTHOR_MARK=

# Worker configuration
OCR_PROVIDER=tencent
TENCENTCLOUD_REGION=ap-guangzhou
ADMIN_API_TOKEN=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TURNSTILE_SECRET_KEY=

# Required by GitHub Actions; optional locally after `wrangler login`
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
