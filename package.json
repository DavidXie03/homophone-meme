{
  "name": "homophone-memes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:all",
    "dev:web": "next dev --hostname 0.0.0.0 --port 43127",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "dev:all": "concurrently -k -n web,api,admin -c blue,magenta,yellow \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:admin\"",
    "build": "next build",
    "build:production": "NEXT_PUBLIC_API_BASE_URL=/api next build",
    "build:admin": "vite build --config apps/admin/vite.config.ts",
    "build:admin:production": "VITE_API_BASE_URL=/api vite build --config apps/admin/vite.config.ts",
    "build:all": "npm run build:production && npm run build:admin:production",
    "verify": "npm run typecheck && npm run lint && npm test",
    "check": "npm run verify && npm run build:all",
    "cloudflare:config": "node scripts/render-cloudflare-config.mjs",
    "deploy": "node scripts/deploy.mjs all",
    "deploy:api": "node scripts/deploy.mjs api",
    "deploy:web": "node scripts/deploy.mjs web",
    "deploy:admin": "node scripts/deploy.mjs admin",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hono/node-server": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "pinyin-pro": "^3.29.3",
    "pokemon": "^3.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
