# Local frontend → local Hono API.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:43128

# Baked into generated posters at frontend build time. Leave empty to hide.
NEXT_PUBLIC_AUTHOR_MARK=

# Local API
API_PORT=43128
PUBLIC_WEB_URL=http://127.0.0.1:43127
WEB_ORIGINS=http://127.0.0.1:43127,http://localhost:43127
ADMIN_ORIGINS=http://127.0.0.1:43129,http://localhost:43129
ADMIN_API_TOKEN=

# Separate private admin app
VITE_API_BASE_URL=http://127.0.0.1:43128
VITE_PUBLIC_WEB_URL=http://127.0.0.1:43127

# OCR: leave as mock for built-in samples.
# Tencent GeneralBasicOCR includes 1,000 free calls/month.
OCR_PROVIDER=mock
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou

# Optional abuse protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
